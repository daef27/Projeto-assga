{
  "version": 2,
  "builds": [
    {
      "src": "wsgi_config.py",
      "use": "@vercel/python"
    }
  ],
  "buildCommand": "bash build.sh",
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "/media/$1"
    },
    {
      "src": "/(.*)",
      "dest": "wsgi_config.py"
    }
  ],
  "env": {
    "DEBUG": "False",
    "DJANGO_SETTINGS_MODULE": "core.settings"
  }
}
