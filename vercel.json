{
  "version": 2,
  "buildCommand": "mkdir -p staticfiles && python3 manage.py collectstatic --noinput || true",
  "outputDirectory": "staticfiles",
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "core/wsgi.py"
    }
  ]
}