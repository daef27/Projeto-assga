{
  "version": 2,
  "outputDirectory": "public",
  "buildCommand": "bash build.sh",
  "builds": [
    {
      "src": "core/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "core/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_DEBUG": "False",
    "DJANGO_SETTINGS_MODULE": "core.settings"
  }
}